<Application x:Class="Tweaker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Theme.Tokens.xaml"/>
        <ResourceDictionary Source="Resources/Theme.Icons.xaml"/>
        <ResourceDictionary Source="Resources/Theme.Controls.xaml"/>
        <ResourceDictionary Source="Resources/Theme.Support.xaml"/>
        <ResourceDictionary Source="Resources/Theme.Home.xaml"/>
        <ResourceDictionary Source="Resources/Theme.Home.Components.xaml"/>
        <ResourceDictionary Source="Resources/Theme.Progress.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
