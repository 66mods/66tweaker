<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>66mods Tweaker</AssemblyName>
    <Product>66mods Tweaker</Product>
    <Authors>66mods</Authors>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Description>Local reversible Windows performance control center by 66mods.</Description>
    <Copyright>66mods 2026</Copyright>
    <ApplicationIcon>Assets\66mods-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Keeps referenced projects' .pdb/.xml out of the published artifact; they still build locally for tests. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tweaker.Domain\Tweaker.Domain.csproj" />
    <ProjectReference Include="..\Tweaker.Infrastructure.Windows\Tweaker.Infrastructure.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\66mods-logo.png" />
    <!-- The emblem clip: H.264 for Media Foundation (see MediaFoundationVideo), copied out to the local cache
         folder on first run; and the same clip as palette frames (see EmblemFrames) for editions without codecs. -->
    <Resource Include="Assets\emblem.mp4" />
    <Resource Include="Assets\emblem.frames" />
    <!-- Compiled pixel shader. The .hlsl beside it is the source; fxc from the Windows SDK rebuilds it. -->
    <Resource Include="Effects\Aurora.ps" />
    <None Remove="Effects\*.hlsl" />
    <Content Include="Effects\*.hlsl" CopyToOutputDirectory="Never" Pack="false" />
  </ItemGroup>
</Project>
