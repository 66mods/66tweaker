<Window x:Class="Tweaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Tweaker.App.Views"
        Title="66mods Tweaker"
        Width="1360" Height="860" MinWidth="1000" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0"/>
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.RowSpan="2" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#20232B" BorderThickness="0,0,1,0">
      <Grid Margin="18,20,18,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <!-- Navigation scrolls: on a short window the advanced tools used to be cut off entirely,
               leaving the advanced tools unreachable. -->
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
          <Border Width="150" Height="88" ClipToBounds="True">
            <Image Source="Assets/66mods-logo.png" Width="188" Height="188" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          </Border>
          <!--
            Lockup rather than a label: one weight, wide tracking, and a hairline under it. This appears in
            every screenshot anyone posts, so it is worth being deliberate about.
          -->
          <StackPanel HorizontalAlignment="Center" Margin="0,4,0,0">
            <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Bold"
                       FontFamily="Segoe UI Variable Display" Foreground="{StaticResource TextBrush}">
              <Run Text="6 6"/><Run Text="  M O D S" Foreground="{StaticResource PrimaryHoverBrush}"/>
            </TextBlock>
            <Border Height="1" Width="86" Margin="0,7,0,0" HorizontalAlignment="Center"
                    Background="{StaticResource AccentSweepBrush}" Opacity="0.55"/>
            <TextBlock Text="TWEAKER" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="9.5"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}"/>
          </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <ToggleButton x:Name="HomeNavigation" Tag="0" Style="{StaticResource NavigationButtonStyle}" Click="Navigate_OnClick">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.HomeOutline}" Style="{StaticResource NavigationIconPathStyle}"/><TextBlock Text="Home" Style="{StaticResource NavigationTextStyle}"/></StackPanel>
          </ToggleButton>
          <ToggleButton Tag="1" Style="{StaticResource NavigationButtonStyle}" Click="Navigate_OnClick">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.OptimizeOutline}" Style="{StaticResource NavigationIconPathStyle}"/><TextBlock Text="Optimize" Style="{StaticResource NavigationTextStyle}"/></StackPanel>
          </ToggleButton>
          <ToggleButton Tag="2" Style="{StaticResource NavigationButtonStyle}" Click="Navigate_OnClick">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.GameOutline}" Style="{StaticResource NavigationIconPathStyle}"/><TextBlock Text="Games" Style="{StaticResource NavigationTextStyle}"/></StackPanel>
          </ToggleButton>
          <ToggleButton Tag="5" Style="{StaticResource NavigationButtonStyle}" Click="Navigate_OnClick">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.RestoreOutline}" Style="{StaticResource NavigationIconPathStyle}"/><TextBlock Text="Restore" Style="{StaticResource NavigationTextStyle}"/></StackPanel>
          </ToggleButton>
          <ToggleButton Tag="7" Style="{StaticResource NavigationButtonStyle}" Click="Navigate_OnClick">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.SettingsOutline}" Style="{StaticResource NavigationIconPathStyle}"/><TextBlock Text="Settings" Style="{StaticResource NavigationTextStyle}"/></StackPanel>
          </ToggleButton>
          <TextBlock Text="ADVANCED TOOLS" Style="{StaticResource DataLabelStyle}" Margin="12,16,0,5"/>
          <ToggleButton Tag="3" Style="{StaticResource AdvancedNavigationButtonStyle}" Click="Navigate_OnClick"><TextBlock Text="About the tweaks" Style="{StaticResource AdvancedNavigationTextStyle}"/></ToggleButton>
          <ToggleButton Tag="4" Style="{StaticResource AdvancedNavigationButtonStyle}" Click="Navigate_OnClick"><TextBlock Text="Repair Center" Style="{StaticResource AdvancedNavigationTextStyle}"/></ToggleButton>
          <ToggleButton Tag="6" Style="{StaticResource AdvancedNavigationButtonStyle}" Click="Navigate_OnClick"><TextBlock Text="History" Style="{StaticResource AdvancedNavigationTextStyle}"/></ToggleButton>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
          <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="10,0,0,10"/>
          <Button Tag="https://discord.com/invite/66mods" Click="OfficialLink_OnClick" Style="{StaticResource SidebarLinkButtonStyle}">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Discord}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Join our Discord" Margin="9,0,0,0"/><Path Data="{StaticResource Icon.ExternalLink}" Width="11" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="8,0,0,0"/></StackPanel>
          </Button>
          <Button Tag="https://www.youtube.com/@66mods" Click="OfficialLink_OnClick" Style="{StaticResource SidebarLinkButtonStyle}" Margin="0,2,0,0" Content="YouTube / @66mods"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource WindowBrush}" BorderBrush="#20232B" BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock Text="66mods Tweaker" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource WindowButtonStyle}" Click="Minimize_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"><Path Data="{StaticResource Icon.Minimize}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextBrush}"/></Button>
          <Button Style="{StaticResource WindowButtonStyle}" Click="Maximize_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize or restore"><Path Data="{StaticResource Icon.Maximize}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextBrush}"/></Button>
          <Button Style="{StaticResource CloseWindowButtonStyle}" Click="Close_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"><Path Data="{StaticResource Icon.Close}" Width="12" Height="12" Stretch="Uniform" Fill="{StaticResource TextBrush}"/></Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Grid.Column="1"
                SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                SelectionChanged="Tabs_OnSelectionChanged"
                Style="{StaticResource ContentTabControlStyle}">
      <TabItem><views:HomeView/></TabItem>
      <TabItem><views:OptimizationView/></TabItem>
      <TabItem><views:GamesView/></TabItem>
      <TabItem><views:AboutView/></TabItem>
      <TabItem><views:RepairView/></TabItem>
      <TabItem><views:RestoreView/></TabItem>
      <TabItem><views:HistoryView/></TabItem>
      <TabItem><views:SettingsView/></TabItem>
    </TabControl>
  </Grid>
</Window>
