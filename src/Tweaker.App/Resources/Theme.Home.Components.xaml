<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Tweaker.App.Views">
  <views:MeterWidthConverter x:Key="MeterWidthConverter"/>

  <!-- Flat meter with no chrome: the number is the message, the bar is only its shape. -->
  <Style x:Key="LiveMeterStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Background" Value="#22262F"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource AccentSweepBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
            <Rectangle x:Name="Fill" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsVisible" Value="True">
              <Setter TargetName="Fill" Property="Width">
                <Setter.Value>
                  <MultiBinding Converter="{StaticResource MeterWidthConverter}">
                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Score ring template. The arc, the digits and the stroke colour all read the control's animated
    DisplayScore, so the number and the sweep can never disagree.
  -->
  <Style TargetType="{x:Type views:ScoreRing}">
    <Setter Property="Width" Value="156"/>
    <Setter Property="Height" Value="156"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type views:ScoreRing}">
          <Grid>
            <Ellipse Stroke="#2B2F3B" StrokeThickness="10"/>
            <Path Data="{TemplateBinding Arc}" Stroke="{TemplateBinding VerdictBrush}" StrokeThickness="10"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding ScoreText}" FontSize="52" FontWeight="SemiBold"
                         FontFamily="Segoe UI Variable Display" HorizontalAlignment="Center"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                         HorizontalAlignment="Center" Margin="0,-2,0,0"/>
            </StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One settings row: label on the left, control on the right, separated by a hairline. -->
  <Style x:Key="SettingRowStyle" TargetType="Grid">
    <Setter Property="Margin" Value="20,15"/>
  </Style>

</ResourceDictionary>
