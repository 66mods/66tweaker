  <Style x:Key="NavigationButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource FocusVisual}">
    <Setter Property="Height" Value="50"/>
    <Setter Property="Margin" Value="0,3"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
            <Grid>
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              <Border x:Name="GoldEdge" Width="2" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource GoldBrush}" CornerRadius="1" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{StaticResource HoverBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></MultiTrigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource PressedBrush}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource AccentGradientBrush}"/><Setter TargetName="Frame" Property="BorderBrush" Value="#7E4DE1"/><Setter Property="Foreground" Value="White"/><Setter TargetName="GoldEdge" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AdvancedNavigationButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource NavigationButtonStyle}">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource FocusVisual}">
    <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource HoverBrush}"/><Setter TargetName="Frame" Property="BorderBrush" Value="#3A3F4C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource PressedBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!--
    The border is a gradient rather than one colour: brighter across the top edge, fading to the base by
    the bottom. That single hairline is what gives a flat dark card the sense of sitting above the page.
  -->
  <Style x:Key="HomeSurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Effect" Value="{StaticResource SoftCardShadow}"/>
    <Setter Property="BorderBrush">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#2E3340" Offset="0"/>
          <GradientStop Color="#292D38" Offset="0.35"/>
          <GradientStop Color="#23262F" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HardwareCardStyle" TargetType="Border" BasedOn="{StaticResource HomeSurfaceCardStyle}">
    <Setter Property="Padding" Value="18,15"/>
    <Setter Property="CornerRadius" Value="11"/>
  </Style>
  <Style x:Key="GameRowStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#3A3F4C"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
