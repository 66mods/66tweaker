<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBrush" Color="#0E0F13"/>
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#101116"/>
  <!--
    Surfaces carry a slight top-to-bottom lift rather than being flat fills: in a dark theme a perfectly
    even panel reads as a hole, and the gradient is what makes a card look like it sits above the page.
    Raised surfaces are also a touch warmer than the base, which is what separates them at a glance.
  -->
  <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#181A22" Offset="0"/><GradientStop Color="#14161D" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="HeroSurfaceBrush" Color="#171922"/>
  <LinearGradientBrush x:Key="RaisedSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1E212B" Offset="0"/><GradientStop Color="#191C24" Offset="1"/>
  </LinearGradientBrush>

  <!-- Hairline along a card's top edge; the light source is above, so only that edge catches it. -->
  <SolidColorBrush x:Key="CardEdgeHighlightBrush" Color="#2E3340"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#20232D"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#292D38"/>
  <SolidColorBrush x:Key="HeroBorderBrush" Color="#313541"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F4F2F7"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#9692A5"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9692A5"/>
  <SolidColorBrush x:Key="SubtleTextBrush" Color="#6F6B7A"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#8B5CF6"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#9D74FA"/>
  <SolidColorBrush x:Key="PressedBrush" Color="#7443E8"/>
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="#2A1A3A"/>
  <SolidColorBrush x:Key="FocusBrush" Color="#B889FF"/>
  <SolidColorBrush x:Key="GoldBrush" Color="#D9A928"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#E6B94A"/>
  <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4DD46A"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#EF6262"/>
  <SolidColorBrush x:Key="DisabledBrush" Color="#5D5A68"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#414653"/>

  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#8B5CF6" Offset="0"/>
    <GradientStop Color="#C026D3" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#9D74FA" Offset="0"/>
    <GradientStop Color="#D63AE6" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradientPressedBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#7443E8" Offset="0"/>
    <GradientStop Color="#A31FB0" Offset="1"/>
  </LinearGradientBrush>
  <!-- Left-to-right accent used by the Home category bar, so its segments read as one continuous sweep. -->
  <LinearGradientBrush x:Key="AccentSweepBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#8B5CF6" Offset="0"/>
    <GradientStop Color="#C026D3" Offset="1"/>
  </LinearGradientBrush>

  <!-- Brand-adjacent accents for the detected-game rows. -->
  <SolidColorBrush x:Key="GameRobloxBrush" Color="#E2231A"/>
  <SolidColorBrush x:Key="GameValorantBrush" Color="#FF4655"/>
  <SolidColorBrush x:Key="GameGtaBrush" Color="#75B843"/>
  <SolidColorBrush x:Key="GameMinecraftBrush" Color="#7FB238"/>
  <SolidColorBrush x:Key="GameFortniteBrush" Color="#4FA3E3"/>

  <!--
    Card backdrops. A wash of the brand colour over the surface, not the brand colour itself: the tile has
    to read as part of this app rather than as a pasted logo, and white text must stay legible on it.
  -->
  <LinearGradientBrush x:Key="GameRobloxWashBrush" StartPoint="0,0" EndPoint="0.7,1">
    <GradientStop Color="#3A1614" Offset="0"/><GradientStop Color="#191C24" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GameValorantWashBrush" StartPoint="0,0" EndPoint="0.7,1">
    <GradientStop Color="#3B1A20" Offset="0"/><GradientStop Color="#191C24" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GameGtaWashBrush" StartPoint="0,0" EndPoint="0.7,1">
    <GradientStop Color="#22331A" Offset="0"/><GradientStop Color="#191C24" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GameMinecraftWashBrush" StartPoint="0,0" EndPoint="0.7,1">
    <GradientStop Color="#243418" Offset="0"/><GradientStop Color="#191C24" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GameFortniteWashBrush" StartPoint="0,0" EndPoint="0.7,1">
    <GradientStop Color="#152A3C" Offset="0"/><GradientStop Color="#191C24" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#1A1D26" Offset="0"/>
    <GradientStop Color="#14161D" Offset="0.56"/>
    <GradientStop Color="#191724" Offset="1"/>
  </LinearGradientBrush>

  <DropShadowEffect x:Key="SoftCardShadow" Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.20"/>
  <DropShadowEffect x:Key="SoftLogoShadow" Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.18"/>

  <StaticResource x:Key="BackgroundBrush" ResourceKey="WindowBrush"/>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
  </Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
    <Setter Property="FontSize" Value="21"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style x:Key="RowTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
  </Style>
  <Style x:Key="RowMetaStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="DataLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
  </Style>
  <Style x:Key="BodyMutedStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="InlineStatusStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Success"><Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/></Trigger>
      <Trigger Property="Tag" Value="Error"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></Trigger>
      <Trigger Property="Tag" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="20"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="OperationRowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="StatusChipStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="10,5"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Success"><Setter Property="BorderBrush" Value="#344C3D"/></Trigger>
      <Trigger Property="Tag" Value="Warning"><Setter Property="BorderBrush" Value="#50452A"/></Trigger>
      <Trigger Property="Tag" Value="Error"><Setter Property="BorderBrush" Value="#573037"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="StatusBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusChipStyle}">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="8,3"/>
  </Style>
  <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource CardStyle}"/>
  <Style TargetType="Separator"><Setter Property="Background" Value="{StaticResource BorderBrush}"/></Style>
</ResourceDictionary>
