<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Tweaker.App.Views">

  <!-- Selectable profile card: the accent border and soft fill mark the current choice. -->
  <Style x:Key="ProfileChoiceStyle" TargetType="RadioButton" BasedOn="{StaticResource FocusVisual}">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Frame" Background="{StaticResource RaisedSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="11" Padding="16,14">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#3A3F4C"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
              <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
              <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Frame" Property="Padding" Value="15,13"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Indeterminate run indicator. The work has no measurable percentage (a UAC prompt or a driver write
    can take any amount of time), so the bar reports "busy" honestly rather than faking a percentage.
    Under Reduce Motion the sweep is replaced by a static accent fill.
  -->
  <Style x:Key="RunIndicatorStyle" TargetType="Border">
    <Setter Property="Height" Value="4"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="#22262F"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style x:Key="RunIndicatorSweepStyle" TargetType="Border">
    <Setter Property="Width" Value="150"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="{StaticResource AccentSweepBrush}"/>
    <Setter Property="RenderTransformOrigin" Value="0,0"/>
  </Style>

  <!-- Outcome banner. Tag carries Success / Warning / Error and selects the accent. -->
  <Style x:Key="OutcomeBannerStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,14"/>
    <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Success"><Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBrush}"/></Trigger>
      <Trigger Property="Tag" Value="Warning"><Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/></Trigger>
      <Trigger Property="Tag" Value="Error"><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="OutcomeIconStyle" TargetType="Path">
    <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding OutcomeKind}" Value="Success">
        <Setter Property="Data" Value="{StaticResource Icon.CheckCircle}"/>
        <Setter Property="Fill" Value="{StaticResource StatusSuccessBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding OutcomeKind}" Value="Warning">
        <Setter Property="Data" Value="{StaticResource Icon.Warning}"/>
        <Setter Property="Fill" Value="{StaticResource GoldBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding OutcomeKind}" Value="Error">
        <Setter Property="Data" Value="{StaticResource Icon.CrossCircle}"/>
        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PreviewLineStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="11,8"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>

  <!--
    Run console. Full Legacy narrates all 1493 commands, so the list is virtualized and lines are fixed
    height: a plain ItemsControl in a ScrollViewer would realise every row and stall the UI for seconds.
    Wrapping is off for the same reason and because a wrapped registry path is harder to scan than a
    truncated one; the full text is always available through Copy.
  -->
  <SolidColorBrush x:Key="LogOkBrush" Color="#7C8598"/>
  <SolidColorBrush x:Key="LogSkipBrush" Color="#5E6070"/>
  <SolidColorBrush x:Key="LogFailBrush" Color="#E2707F"/>
  <SolidColorBrush x:Key="LogInfoBrush" Color="#C6C9D4"/>

  <DataTemplate x:Key="RunConsoleTemplate">
    <Border Background="#0C0E13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9"
            Padding="12,10" Height="260">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasLines}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,7">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="OUTPUT" FontSize="10.5" FontWeight="SemiBold" Opacity="0.75"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding LineCountLabel}" FontSize="10.5" Margin="10,0,0,0" Opacity="0.6"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding IssueLabel}" FontSize="10.5" Margin="10,0,0,0" FontWeight="SemiBold"
                       Foreground="{StaticResource LogFailBrush}" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasIssues}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox Content="Only problems" IsChecked="{Binding ShowOnlyIssues}" FontSize="11.5"
                      VerticalAlignment="Center" Margin="0,0,10,0"
                      Foreground="{StaticResource SecondaryTextBrush}"/>
            <Button Content="Copy" Command="{Binding CopyLogCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Padding="9,3" MinHeight="0" FontSize="11.5"/>
          </StackPanel>
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0"
                 Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel" views:AutoScroll.Follow="True">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                         TextTrimming="CharacterEllipsis" Margin="0,0,0,1">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource LogInfoBrush}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding KindName}" Value="Ok">
                        <Setter Property="Foreground" Value="{StaticResource LogOkBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding KindName}" Value="Skip">
                        <Setter Property="Foreground" Value="{StaticResource LogSkipBrush}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding KindName}" Value="Fail">
                        <Setter Property="Foreground" Value="{StaticResource LogFailBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </DataTemplate>
  <!-- Tickable optimization group. Reads as a card, behaves as a checkbox. -->
  <Style x:Key="CategoryChoiceStyle" TargetType="ToggleButton" BasedOn="{StaticResource FocusVisual}">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Shell" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,13">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Tick" Width="17" Height="17" CornerRadius="5" Margin="0,2,12,0" VerticalAlignment="Top"
                      Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.4">
                <Path x:Name="Mark" Data="{StaticResource Icon.Check}" Stretch="Uniform" Margin="3"
                      Fill="White" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource HeroBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
              <Setter TargetName="Shell" Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
              <Setter TargetName="Tick" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
              <Setter TargetName="Tick" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Optimization group card. Tag carries the run state and selects the border accent. -->
  <Style x:Key="CategoryCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,13"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Running">
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
        <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Applied"><Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBrush}"/></Trigger>
      <Trigger Property="Tag" Value="Failed"><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/></Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Measured before/after. This is the one claim no competitor can copy without an exact snapshot of the
    machine taken before the run: the numbers are read from Windows, not derived from how many commands
    were sent. Rows that did not move are omitted rather than shown as zeroes, and a run whose settings
    only apply after a restart says so in words.
  -->
  <DataTemplate x:Key="RunChangeTemplate">
    <Border Background="#101520" BorderBrush="#24313F" BorderThickness="1" CornerRadius="9" Padding="14,12">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasChange}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <TextBlock Text="{Binding ChangeCaption}" FontSize="11.5" FontWeight="SemiBold"
                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding ChangeRows}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="54"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12.5"/>
                <TextBlock Grid.Column="1" Text="{Binding Before}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                           Foreground="{StaticResource SubtleTextBrush}"/>
                <TextBlock Grid.Column="2" Text="  &#x2192;  " FontSize="12.5" Foreground="{StaticResource SubtleTextBrush}"/>
                <views:CountingText Grid.Column="3" From="{Binding Before}" To="{Binding After}"
                                    FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                    FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Grid.Column="4" Text="{Binding Delta}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                           HorizontalAlignment="Right" FontWeight="SemiBold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsImprovement}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>

  <views:RunArcConverter x:Key="RunArcConverter"/>
  <views:ResourceKeyConverter x:Key="ResourceKeyConverter"/>

  <!--
    Run ring. Determinate whenever the worker has narrated a counted effect, and a quiet pulsing track
    before that: a run spends its first seconds starting an elevated process, where there is genuinely
    nothing to measure and pretending otherwise would be a lie.
  -->
  <DataTemplate x:Key="RunRingTemplate">
    <Grid Width="128" Height="128">
      <!--
        A slow breathing halo while the run is working. It stops the moment the run ends, and Reduce
        Motion never starts it: a pulse is the one thing on this page that moves for its own sake.
      -->
      <Ellipse x:Name="Halo" Width="128" Height="128" Fill="{StaticResource PrimarySoftBrush}" Opacity="0">
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsRunning}" Value="True"/>
                  <Condition Binding="{Binding ReduceMotion}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard Name="Pulse">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.10" To="0.55"
                                       Duration="0:0:1.3" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="Pulse"/>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
      <Ellipse Width="120" Height="120" StrokeThickness="8" Stroke="#232936"/>
      <Path Data="{Binding ProgressPercent, Converter={StaticResource RunArcConverter}}"
            StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Stroke="{StaticResource AccentSweepBrush}" Width="128" Height="128"/>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock HorizontalAlignment="Center" FontSize="27" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="…"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasProgress}" Value="True">
                  <Setter Property="Text" Value="{Binding ProgressPercent, StringFormat={}{0}%}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding ProgressCaption}" HorizontalAlignment="Center" Margin="0,3,0,0"
                   FontSize="11" FontFamily="Cascadia Mono, Consolas"
                   Foreground="{StaticResource SubtleTextBrush}"/>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- The optimization group card, shared by the reversible and aggressive lists. -->
  <DataTemplate x:Key="CategoryCardTemplate">
                <Border Style="{StaticResource CategoryCardStyle}" Tag="{Binding StateName}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Path Data="{Binding IconKey, Converter={StaticResource ResourceKeyConverter}}" Width="22" Height="22"
                          Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,12,0"
                          Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                    <StackPanel Grid.Column="1">
                      <Grid>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitleStyle}" FontSize="14.5"/>
                          <Border Background="#2A1D22" CornerRadius="4" Padding="6,1" Margin="8,1,0,0" VerticalAlignment="Center">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsExperimental}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="RISKY" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                          </Border>
                        </StackPanel>
                        <!-- Muted: on this page the Run button is the accent, not the count beside it. -->
                        <TextBlock Text="{Binding EffectLabel}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                      </Grid>
                      <TextBlock Text="{Binding Summary}" Style="{StaticResource RowMetaStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Caution}" FontSize="11.5" Margin="0,5,0,0"
                                 Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasCaution}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                      <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding StateName}" Value="Applied">
                                <Setter Property="Text" Value="Applied"/>
                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding StateName}" Value="Failed">
                                <Setter Property="Text" Value="Failed - see the output below"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding StateName}" Value="Running">
                                <Setter Property="Text" Value="Running…"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Button Content="{Binding ActionLabel}" Command="{Binding RunCommand}"
                              IsEnabled="{Binding IsEnabled}" HorizontalAlignment="Right"
                              Style="{StaticResource PrimaryButtonStyle}" Padding="18,7" MinHeight="0" FontSize="12.5"/>
                    </Grid>
                  </Grid>
                </Border>
  </DataTemplate>

</ResourceDictionary>
