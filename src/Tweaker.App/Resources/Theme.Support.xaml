<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Support-page status accent and text input remain centralized with the primary dark theme. -->
  <SolidColorBrush x:Key="InfoBrush" Color="#5DADE2"/>
  <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6BCB9A"/>
  <Style x:Key="DarkTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FocusVisual}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Background" Value="{StaticResource RaisedSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource PrimarySoftBrush}"/>
    <Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Background="Transparent"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}"/>
</ResourceDictionary>
