<UserControl x:Class="Tweaker.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tweaker.App.Views">
  <!-- A settings page is a list of things you can change. Motion, where the backups live, the links. -->
  <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,14,40,26" local:Entrance.ReduceMotion="{Binding ReduceMotion}">

      <TextBlock Text="Settings" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Everything here is local to this PC." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>

      <Border Style="{StaticResource GlassPanelStyle}" Margin="0,18,0,0" Padding="0" local:Entrance.Order="0">
        <StackPanel>

          <Grid Style="{StaticResource SettingRowStyle}">
            <StackPanel VerticalAlignment="Center" Margin="0,0,80,0">
              <TextBlock Text="Reduce motion" Style="{StaticResource RowTitleStyle}"/>
              <TextBlock Text="Stops the backdrop, the emblem and every hover effect. Off by default." Style="{StaticResource RowMetaStyle}" Margin="0,3,0,0"/>
            </StackPanel>
            <CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                      IsChecked="{Binding ReduceMotion, Mode=TwoWay}" ToolTip="Reduce motion"/>
          </Grid>

          <Border Height="1" Background="{StaticResource GlassEdgeBrush}"/>

          <Grid Style="{StaticResource SettingRowStyle}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Where your backups live" Style="{StaticResource RowTitleStyle}"/>
              <TextBlock Text="%LocalAppData%\66mods Tweaker\Transactions" FontFamily="Cascadia Mono, Consolas"
                         FontSize="12" Foreground="{StaticResource Ink45Brush}" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{StaticResource GlassEdgeBrush}"/>

          <Grid Style="{StaticResource SettingRowStyle}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Administrator rights" Style="{StaticResource RowTitleStyle}"/>
              <TextBlock Text="Every operation is listed for you to confirm before it runs."
                         Style="{StaticResource RowMetaStyle}" Foreground="{StaticResource GoldGlowBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{StaticResource GlassEdgeBrush}"/>

          <Grid Style="{StaticResource SettingRowStyle}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Official links" Style="{StaticResource RowTitleStyle}"/>
              <TextBlock Text="Opens in your browser." Style="{StaticResource RowMetaStyle}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Border Style="{StaticResource GameRowStyle}" Padding="12,8" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource Icon.ExternalLink}" Width="13" Height="13" Stretch="Uniform"
                        Fill="{StaticResource PrimaryHoverBrush}" VerticalAlignment="Center"/>
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5">
                    <Hyperlink NavigateUri="https://www.youtube.com/@66mods" RequestNavigate="OfficialLink_OnRequestNavigate"
                               Foreground="{StaticResource TextBrush}" TextDecorations="None">YouTube</Hyperlink>
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource GameRowStyle}" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource Icon.Discord}" Width="15" Height="15" Stretch="Uniform"
                        Fill="{StaticResource PrimaryHoverBrush}" VerticalAlignment="Center"/>
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5">
                    <Hyperlink NavigateUri="https://discord.com/invite/66mods" RequestNavigate="OfficialLink_OnRequestNavigate"
                               Foreground="{StaticResource TextBrush}" TextDecorations="None">Discord</Hyperlink>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

        </StackPanel>
      </Border>

      <TextBlock Text="No updater · No telemetry · No downloads · No network"
                 Style="{StaticResource RowMetaStyle}" Foreground="{StaticResource StatusSuccessBrush}"
                 HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
