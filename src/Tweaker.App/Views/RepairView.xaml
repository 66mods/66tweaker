<UserControl x:Class="Tweaker.App.Views.RepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tweaker.App.Views">
  <UserControl.Resources>
    <Style x:Key="RepairRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource FocusVisual}">
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="12,9">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource Tint6Brush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{StaticResource SelectedCardBrush}"/>
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource SelectedCardBorderBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- A list of fixed Windows repairs on the left, the chosen one explained on the right, one panel. -->
  <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,14,40,26" local:Entrance.ReduceMotion="{Binding ReduceMotion}">
      <TextBlock Text="Repair Center" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Only the selected Windows tool runs, and only after you confirm." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>

      <Border Style="{StaticResource GlassPanelStyle}" Margin="0,18,0,0" local:Entrance.Order="0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <StackPanel Margin="0,0,20,0">
            <TextBlock Text="Repair action" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Repair.Actions}" SelectedItem="{Binding Repair.SelectedAction, Mode=TwoWay}"
                     Style="{x:Null}" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource RepairRowStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <Border Grid.Column="1" Background="{StaticResource GlassEdgeBrush}"/>

          <StackPanel Grid.Column="2" Margin="26,0,0,0">
            <TextBlock Text="{Binding Repair.SelectedAction.Name}" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Repair.SelectedAction.Description}" Style="{StaticResource BodyMutedStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="REQUIREMENTS" Style="{StaticResource DataLabelStyle}" Foreground="{StaticResource Ink45Brush}" Margin="0,18,0,6"/>
            <TextBlock Text="{Binding Repair.SelectedAction.Requirements}" Foreground="{StaticResource GoldGlowBrush}" FontSize="13.5" TextWrapping="Wrap"/>
            <Button Content="Review and run" Command="{Binding Repair.RunCommand}" Style="{StaticResource CtaButtonStyle}" Height="48" FontSize="15"
                    HorizontalAlignment="Left" Margin="0,22,0,0" Padding="24,0"/>
            <TextBlock Text="{Binding Repair.Status}" Style="{StaticResource RowMetaStyle}" TextWrapping="Wrap" Margin="0,16,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
