<UserControl x:Class="Tweaker.App.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tweaker.App.Views">
  <UserControl.Resources>
    <local:CountToStarConverter x:Key="CountToStarConverter"/>
    <local:ResourceKeyConverter x:Key="ResourceKeyConverter"/>

    <!-- One group: a card that is a switch. Click anywhere on it to tick it. -->
    <Style x:Key="GroupCardStyle" TargetType="ToggleButton" BasedOn="{StaticResource FocusVisual}">
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Height" Value="164"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="local:Lift.IsEnabled" Value="True"/>
      <Setter Property="local:Lift.Height" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" CornerRadius="20" BorderThickness="1" Padding="18,16,16,16"
                    Background="{StaticResource Tint4Brush}" BorderBrush="{StaticResource GlassEdgeBrush}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource Tint8Brush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{StaticResource SelectedCardBrush}"/>
                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource SelectedCardBorderBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
    <Grid Margin="40,14,40,26" local:RunDim.ReduceMotion="{Binding ReduceMotion}" local:Entrance.ReduceMotion="{Binding ReduceMotion}">
      <Border Style="{StaticResource GlassPanelStyle}" Padding="26,24,14,22" local:Entrance.Order="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid local:RunDim.IsRunning="{Binding Optimization.Progress.IsRunning}" Margin="0,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Optimization" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Optimization.SelectedSummary}" FontSize="13" Foreground="{StaticResource Ink60Brush}" VerticalAlignment="Center"/>
              <Button Content="Select recommended" Style="{StaticResource LinkButtonStyle}" Command="{Binding Optimization.SelectRecommendedCommand}" Margin="14,0,0,0" VerticalAlignment="Center"/>
              <Button Content="Clear" Style="{StaticResource LinkButtonStyle}" Command="{Binding Optimization.ClearCategoriesCommand}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <ItemsControl Grid.Row="1" ItemsSource="{Binding Optimization.Categories}" Margin="0,18,0,0"
                        local:RunDim.IsRunning="{Binding Optimization.Progress.IsRunning}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ToggleButton Style="{StaticResource GroupCardStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                              ToolTip="{Binding Summary}">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Display" FontSize="16.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,54,0" LineHeight="20"/>
                    <TextBlock Grid.Row="1" Text="{Binding Meta}" FontSize="12.5" Foreground="{StaticResource Ink45Brush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsSelected, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Grid.RowSpan="2"/>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                      <Border Style="{StaticResource StatePillStyle}" Tag="{Binding PillKind}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PillText}" Style="{StaticResource StatePillTextStyle}" Tag="{Binding PillKind}"/>
                      </Border>
                      <local:ImpactMeter Filled="{Binding ImpactSegments}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <local:ImpactMeter.Style>
                          <Style TargetType="local:ImpactMeter">
                            <Setter Property="Accent" Value="{StaticResource PrimaryBrush}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Accent" Value="{StaticResource GoldGlowBrush}"/></DataTrigger></Style.Triggers>
                          </Style>
                        </local:ImpactMeter.Style>
                      </local:ImpactMeter>
                    </Grid>
                  </Grid>
                </ToggleButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid Grid.Row="3" Margin="0,14,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="RunButton" Style="{StaticResource CtaButtonStyle}" Command="{Binding Optimization.RunSelectedCommand}" IsEnabled="{Binding Optimization.AnyCategorySelected}"
                    ToolTip="Runs the ticked groups as one transaction, after one administrator prompt">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Run" VerticalAlignment="Center"/>
                <Border Width="1" Height="22" Background="#4DFFFFFF" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding Optimization.RunLabel}" Style="{StaticResource CtaDetailStyle}"/>
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
              <TextBlock Text="restart after · " FontSize="13" Foreground="{StaticResource GoldGlowBrush}" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Optimization.SelectedRequiresRestart}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="restore point automatic · every value recorded first" FontSize="13" Foreground="{StaticResource Ink45Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Protected history" Style="{StaticResource LinkButtonStyle}" Command="{Binding Optimization.ProtectedHistoryCommand}" Margin="0,0,14,0"
                      ToolTip="Opens the elevated worker's own record of administrator runs"/>
              <Button Content="Undo last run" Style="{StaticResource LinkButtonStyle}" Command="{Binding Optimization.UndoCommand}" FontSize="13.5"/>
            </StackPanel>
          </Grid>

          <local:ApplyPanel Grid.Row="2" DataContext="{Binding Optimization.Progress}" Margin="0,8,12,0" VerticalAlignment="Top"
                            ReduceMotion="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <local:ApplyPanel.Style>
              <Style TargetType="local:ApplyPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  <DataTrigger Binding="{Binding HasOutcome}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </local:ApplyPanel.Style>
          </local:ApplyPanel>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
