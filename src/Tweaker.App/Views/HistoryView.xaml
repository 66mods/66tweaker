<UserControl x:Class="Tweaker.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tweaker.App.Views">
  <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="40,14,40,26" local:Entrance.ReduceMotion="{Binding ReduceMotion}">
      <TextBlock Text="History" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Every run recorded on this PC. Nothing leaves it." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>

      <Border Style="{StaticResource GlassPanelStyle}" Margin="0,18,0,0" local:Entrance.Order="0">
        <Grid>
          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding History.HasItems}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Grid Margin="0,0,0,14">
              <TextBlock Text="Recorded sessions" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding History.LastOptimization.Timestamp, StringFormat=Latest: {0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Ink45Brush}" FontSize="13"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding History.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StartedAt}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource Ink60Brush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Rolled back"><Setter Property="Foreground" Value="{StaticResource GoldGlowBrush}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding Summary}" FontSize="13" Foreground="#D9FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers><DataTrigger Binding="{Binding History.HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="No runs yet" FontFamily="Segoe UI Variable Display" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding History.EmptyMessage}" Style="{StaticResource BodyMutedStyle}" Margin="0,6,0,0" MaxWidth="520" HorizontalAlignment="Left" TextWrapping="Wrap"/>
            <Button Content="Open Optimize" Style="{StaticResource GhostPillStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="18,0" Click="OpenOptimize_OnClick"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
