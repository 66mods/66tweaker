<UserControl x:Class="Tweaker.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tweaker.App.Views">
  <UserControl.Resources>
    <local:ResourceKeyConverter x:Key="ResourceKeyConverter"/>
  </UserControl.Resources>

  <!--
    Five cards, one slider. Pick the game, slide between frames and picture, press Apply. What the
    profile writes is one click away rather than on the page, and the driver vendor is named under Apply.
  -->
  <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
    <Grid Margin="40,40,26,26" local:RunDim.ReduceMotion="{Binding ReduceMotion}" local:Entrance.ReduceMotion="{Binding ReduceMotion}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <ListBox ItemsSource="{Binding GameCards}" Style="{x:Null}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
               ItemContainerStyle="{StaticResource GameCardItemStyle}" SelectedValuePath="Name"
               SelectedValue="{Binding GameProfiles.SelectedGame, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
               local:RunDim.IsRunning="{Binding GameProfiles.Progress.IsRunning}" local:Entrance.Order="0">
        <!-- No ScrollViewer in the template: it would clip a card that lifts on hover. -->
        <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter Margin="0,8,0,8"/></ControlTemplate></ListBox.Template>
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <!-- The initial is the artwork: drawn in the app's own type so no cover has to be downloaded. -->
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Variable Display" FontWeight="ExtraBold" FontSize="104"
                         Foreground="{Binding GlyphBrushKey, Converter={StaticResource ResourceKeyConverter}}" Margin="18,2,0,0" VerticalAlignment="Top"/>
              <StackPanel VerticalAlignment="Bottom" Margin="22,0,16,24">
                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Variable Display" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12.5" Margin="0,4,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource Ink45Brush}"/>
                      <Style.Triggers><DataTrigger Binding="{Binding IsDetected}" Value="True"><Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="1" Margin="0,14,14,0" Padding="14,12" CornerRadius="14" Background="{StaticResource GoldSoftBrush}" BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding GameProfiles.HasDetectedGames}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding GameProfiles.NoGamesMessage}" Style="{StaticResource RowMetaStyle}" Foreground="{StaticResource GoldGlowBrush}" TextWrapping="Wrap"/>
      </Border>

      <Grid Grid.Row="2" Margin="0,40,14,0" local:RunDim.IsRunning="{Binding GameProfiles.Progress.IsRunning}" local:Entrance.Order="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Text="{Binding GameProfiles.SelectedProfileName}" FontFamily="Segoe UI Variable Display" FontSize="42" FontWeight="Bold" LineHeight="44" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding GameProfiles.SelectedProfileDescription}" FontSize="14" Foreground="{StaticResource Ink60Brush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
          <local:ProfileSlider x:Name="Slider" Value="{Binding GameProfiles.SelectedProfileIndex, Mode=TwoWay}" ReduceMotion="{Binding ReduceMotion}" Margin="0,24,0,0"
                               ToolTip="Balanced keeps the picture; Ultra Potato buys the most frames"/>

          <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <Grid>
                <TextBlock Text="FRAMES" Style="{StaticResource DataLabelStyle}" Foreground="{StaticResource Ink45Brush}"/>
                <TextBlock Text="{Binding GameProfiles.SelectedFacts.FramesLabel}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              </Grid>
              <ProgressBar Style="{StaticResource TradeBarStyle}" Value="{Binding GameProfiles.SelectedFacts.FramesFraction, Mode=OneWay}" Maximum="1" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Grid>
                <TextBlock Text="IMAGE" Style="{StaticResource DataLabelStyle}" Foreground="{StaticResource Ink45Brush}"/>
                <TextBlock Text="{Binding GameProfiles.SelectedFacts.ImagePercent, StringFormat={}{0}%}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              </Grid>
              <ProgressBar Style="{StaticResource TradeBarStyle}" Foreground="{StaticResource GoldGlowBrush}" Value="{Binding GameProfiles.SelectedFacts.ImagePercent, Mode=OneWay}" Maximum="100" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>

          <!-- Exactly what will be written, one click away. Both halves come from the same source the apply uses. -->
          <ToggleButton x:Name="PreviewToggle" Margin="0,22,0,0" HorizontalAlignment="Left" Cursor="Hand" Focusable="True">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource FocusVisual}">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="2">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="Arrow" Text="›" FontSize="15" Foreground="{StaticResource Ink60Brush}" Margin="0,-1,7,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                          </TextBlock>
                          <TextBlock Text="{Binding GameProfiles.PreviewSummary}" FontSize="13" Foreground="{StaticResource Ink60Brush}" TextDecorations="Underline" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource Tint4Brush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ToggleButton.Style>
          </ToggleButton>
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewerStyle}" Margin="0,8,0,0"
                        Visibility="{Binding IsChecked, ElementName=PreviewToggle, Converter={x:Static local:BooleanToVisibilityConverterInstance.Instance}}">
            <StackPanel>
              <TextBlock Text="{Binding GameProfiles.PreviewCaption}" Style="{StaticResource QuietLineStyle}" Foreground="{StaticResource Ink45Brush}" Margin="0,0,0,8" MaxWidth="600" HorizontalAlignment="Left"/>
              <ItemsControl ItemsSource="{Binding GameProfiles.PreviewApplied}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <Path Data="{StaticResource Icon.CheckCircle}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource StatusSuccessBrush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                      <TextBlock Text="{Binding}" Style="{StaticResource QuietLineStyle}" Margin="0" MaxWidth="560"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding GameProfiles.PreviewSkipped}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                      <Path Data="{StaticResource Icon.CrossCircle}" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource DisabledBrush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                      <TextBlock Text="{Binding}" Style="{StaticResource QuietLineStyle}" Foreground="{StaticResource Ink45Brush}" Margin="0" MaxWidth="560"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,4,0,0">
          <Button x:Name="ApplyButton" Style="{StaticResource CtaButtonStyle}" Content="Apply" MinWidth="150" Padding="34,0" HorizontalAlignment="Right"
                  Command="{Binding GameProfiles.ApplyCommand}" IsEnabled="{Binding GameProfiles.CanApplySelectedGame}"
                  ToolTip="Writes the game's own settings and the driver profile in one transaction"/>
          <TextBlock Text="{Binding GameProfiles.VendorNote}" FontSize="12.5" Foreground="{StaticResource Ink45Brush}" TextWrapping="Wrap" TextAlignment="Left"
                     Margin="0,16,0,0" Width="320" LineHeight="18"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Reset driver profile" Style="{StaticResource LinkButtonStyle}" Command="{Binding GameProfiles.ResetProfileCommand}" IsEnabled="{Binding GameProfiles.CanResetProfile}" Margin="0,0,14,0"
                    ToolTip="Puts the driver profile back exactly as it was before 66mods first wrote to it. Works after a restart of the app."/>
            <Button Content="Undo last" Style="{StaticResource LinkButtonStyle}" Command="{Binding GameProfiles.UndoCommand}"/>
          </StackPanel>
          <Button Content="Close Roblox and clear cache" Style="{StaticResource LinkButtonStyle}" Command="{Binding GameProfiles.ClearCacheCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"
                  ToolTip="Closes Roblox and deletes its downloaded asset cache. A driver profile only takes effect when the game starts."
                  Visibility="{Binding GameProfiles.IsRoblox, Converter={x:Static local:BooleanToVisibilityConverterInstance.Instance}}"/>
        </StackPanel>
      </Grid>

      <local:ApplyPanel Grid.Row="3" DataContext="{Binding GameProfiles.Progress}" Margin="0,20,14,0"
                        ReduceMotion="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <local:ApplyPanel.Style>
          <Style TargetType="local:ApplyPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding HasOutcome}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </local:ApplyPanel.Style>
      </local:ApplyPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
