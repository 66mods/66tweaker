<UserControl x:Class="Tweaker.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tweaker.App.Views">
  <UserControl.Resources>
    <local:HardwareSegmentConverter x:Key="HardwareSegmentConverter"/>
    <local:WindowsSummaryConverter x:Key="WindowsSummaryConverter"/>
    <local:ScoreArcConverter x:Key="ScoreArcConverter"/>
    <local:ResourceKeyConverter x:Key="ResourceKeyConverter"/>
    <local:CountToStarConverter x:Key="CountToStarConverter"/>
  </UserControl.Resources>

  <!--
    Home says one number and offers one action. The score on the left, the emblem on the right, the
    hardware in four chips, and the groups that the button will run in a strip along the bottom.
  -->
  <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
    <Grid Margin="56,12,56,30" MinHeight="500" local:Entrance.ReduceMotion="{Binding ReduceMotion}">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="4*" MinWidth="360"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
        <!-- The number is the page. Scaled down, never up, so a small window still shows all of it. -->
        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="190" local:Entrance.Order="0">
          <TextBlock x:Name="ScoreText" Text="{Binding Optimization.OptimizationScoreText}" FontFamily="Segoe UI Variable Display"
                     FontSize="176" FontWeight="Bold" Foreground="White" Margin="-8,0,0,0" Effect="{StaticResource ScoreGlow}"/>
        </Viewbox>
        <TextBlock Margin="4,6,0,0" FontSize="15" Foreground="{StaticResource Ink60Brush}" local:Entrance.Order="1">
          <Run Text="{Binding Optimization.ScoreCaption, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Optimization.ScoreDetail, Mode=OneWay}"/>
        </TextBlock>

        <Button x:Name="OptimizeButton" Style="{StaticResource CtaButtonStyle}" HorizontalAlignment="Left" Margin="2,26,0,0"
                Command="{Binding Optimization.RunSelectedCommand}" IsEnabled="{Binding Optimization.AnyCategorySelected}"
                local:Entrance.Order="2" ToolTip="Runs the selected groups as one transaction, after one administrator prompt">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Optimize" VerticalAlignment="Center"/>
            <Border Width="1" Height="22" Background="#4DFFFFFF" Margin="16,0,0,0"/>
            <TextBlock Text="{Binding Optimization.RunLabel}" Style="{StaticResource CtaDetailStyle}"/>
          </StackPanel>
        </Button>

        <StackPanel Orientation="Horizontal" Margin="6,16,0,0" local:Entrance.Order="3">
          <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Optimization.SelectedRequiresRestart}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Ellipse Width="6" Height="6" Fill="{StaticResource GoldGlowBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
            <TextBlock Text="restart after" FontSize="13" Foreground="{StaticResource GoldGlowBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <!-- The label is composed in the view model: a StringFormat on Content is ignored (Content is not a string). -->
          <Button Command="{Binding Optimization.UndoCommand}" VerticalAlignment="Center" Style="{StaticResource LinkButtonStyle}"
                  Content="{Binding History.LastOptimization.UndoLabel, FallbackValue='Undo last run'}"
                  ToolTip="Rewinds every run of this session to the values recorded before it"/>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="0" Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:EmblemView x:Name="Emblem" ReduceMotion="{Binding ReduceMotion}" MaxHeight="580" MinHeight="240" Margin="0,0,0,4" local:Entrance.Order="1"/>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,4,0,0" local:Entrance.Order="2">
          <Border Style="{StaticResource ChipStyle}" ToolTip="Processor load, sampled once a second">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="CPU" Style="{StaticResource ChipLabelStyle}"/>
              <TextBlock Style="{StaticResource ChipValueStyle}"><Run Text="{Binding Home.CpuLoadPercent, Mode=OneWay}"/><Run Text="%" Foreground="{StaticResource Ink60Brush}"/></TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ChipStyle}" ToolTip="{Binding Home.MemoryText}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="RAM" Style="{StaticResource ChipLabelStyle}"/>
              <TextBlock Style="{StaticResource ChipValueStyle}"><Run Text="{Binding Home.MemoryLoadPercent, Mode=OneWay}"/><Run Text="%" Foreground="{StaticResource Ink60Brush}"/></TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ChipStyle}" ToolTip="{Binding Home.HardwareHeadline}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="GPU" Style="{StaticResource ChipLabelStyle}"/>
              <TextBlock Text="{Binding Home.GpuChip}" Style="{StaticResource ChipSmallValueStyle}" MaxWidth="150"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ChipStyle}" Margin="0" ToolTip="{Binding Home.StatusDetail}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="OS" Style="{StaticResource ChipLabelStyle}"/>
              <TextBlock Text="{Binding Home.WindowsChip}" Style="{StaticResource ChipSmallValueStyle}"/>
            </StackPanel>
          </Border>
        </WrapPanel>
      </Grid>

      <!-- What the button will run. Each dot is the group's state; Configure opens the Optimize page. -->
      <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0" VerticalAlignment="Bottom" local:Entrance.Order="4">
        <ItemsControl ItemsSource="{Binding Optimization.SelectedCategories}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource StripChipStyle}" ToolTip="{Binding Summary}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Style="{StaticResource StripDotStyle}" Tag="{Binding PillKind}"/>
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource GhostPillStyle}" Content="Configure  →" Click="Configure_OnClick" Margin="4,0,0,0"/>
      </WrapPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
